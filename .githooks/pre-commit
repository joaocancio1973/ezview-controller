#!/usr/bin/env bash

set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "./scripts/git-check.ps1" -HookMode
  exit $?
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./scripts/git-check.ps1" -HookMode
  exit $?
fi

echo "Aviso: PowerShell nao encontrado para executar o pre-commit automatizado."
exit 0
