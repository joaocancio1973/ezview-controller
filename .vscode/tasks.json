{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "git: checklist da fase",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\git-check.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: start",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ]
}
